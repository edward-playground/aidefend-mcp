# AIDEFEND MCP Service Configuration
# Copy this file to .env and customize as needed

# GitHub Repository
GITHUB_REPO_OWNER=edward-playground
GITHUB_REPO_NAME=aidefense-framework
GITHUB_BRANCH=main
GITHUB_TACTICS_PATH=tactics

# Optional: use a local AIDEFEND framework checkout instead of GitHub sync.
# Leave this commented out for normal open-source usage.
# LOCAL_FRAMEWORK_PATH=

# Sync Configuration
SYNC_INTERVAL_SECONDS=3600
SYNC_TIMEOUT_SECONDS=300
ENABLE_AUTO_SYNC=true

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# ⚠️ IMPORTANT: Multi-worker mode is NOT supported
# Each DATA_PATH can be owned by only one REST, MCP, resync, or maintenance
# process at a time, and that process must use a single API worker.
# Setting API_WORKERS > 1 will cause sync conflicts and stale data issues.
# Multiple replicas must use independent data copies/volumes or an external
# data layer designed for concurrent clients; never share one writable volume.
API_WORKERS=1

# Security
# MAX_QUERY_LENGTH set to 1500 to align with the multilingual-e5-base model's 512 token limit
# (1500 chars ≈ 375 tokens at a 4:1 English char:token ratio, leaving buffer for overhead).
# NOTE: for CJK (Chinese/Japanese/Korean) input the ratio is closer to 1-2 tokens per char,
# so a 1500-char CJK query can exceed 512 tokens and be truncated by the tokenizer; lower
# this value if you query primarily in CJK languages.
MAX_QUERY_LENGTH=1500
MAX_TOP_K=20
DEFAULT_TOP_K=5
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60

# Chunked Query Configuration (for long text processing)
# Enables automatic chunking for queries exceeding MAX_QUERY_LENGTH
# Conservative defaults (5000 chars, 5 chunks) balance functionality with security
#
# MAX_TOTAL_QUERY_LENGTH: Maximum total query length (default: 5000 chars)
#   - Queries > MAX_QUERY_LENGTH are automatically chunked
#   - Each chunk is searched independently, results are combined
#   - Use case: Long vulnerability reports, security documents
#   - Security: Prevents DoS via excessive input size
# MAX_CHUNKS: Maximum number of chunks per query (default: 5)
#   - Limits computational overhead
#   - 5 chunks × 1200 chars = ~6000 chars effective capacity
#   - Security: Prevents DoS via excessive chunk count
# MAX_CHUNKS_PROCESSING_TIME: Timeout for chunked queries (default: 15 seconds)
#   - Prevents long-running queries from blocking the service
#   - Security: Timeout protection against resource exhaustion
#
# Example: A 3000-character security report will be split into ~3 chunks,
# searched separately, and results will be deduplicated and ranked.
#
# MAX_TOTAL_QUERY_LENGTH=5000
# MAX_CHUNKS=5
# MAX_CHUNKS_PROCESSING_TIME=15
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200

# Authentication (REST API only - MCP mode uses file permissions)
# AUTH_MODE options:
#   - "no_auth" (default): No authentication required
#       ✓ Suitable for: Local development, personal use on localhost
#       ✗ NOT suitable for: Production deployment, public networks
#   - "api_key": Require API key in X-API-Key header
#       ✓ Suitable for: Production deployment, team collaboration, CI/CD
#       ⚠️ Requires: AIDEFEND_API_KEY to be set
#
# To enable API key authentication:
#   1. Uncomment AUTH_MODE and set to "api_key"
#   2. Generate key: python scripts/generate_api_key.py
#   3. Uncomment AIDEFEND_API_KEY and paste the generated key
#   4. Restart the service
#
# AUTH_MODE=no_auth
# AIDEFEND_API_KEY=<paste-your-generated-api-key-here>

# CORS
ENABLE_CORS=true
# CORS_ORIGINS accepts exact origins only; wildcards such as localhost:* do not work.
# CORS_ORIGINS=["http://localhost:3000"]
# The default CORS_ORIGIN_REGEX already allows http(s) localhost, 127.0.0.1,
# and [::1] on any port. Set it to an empty string to rely only on CORS_ORIGINS.
# CORS_ORIGIN_REGEX=

# Logging
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true

# Advanced: Custom paths (leave as default unless needed)
# Source checkouts default to ./data. Installed wheels default to the OS
# per-user application-data directory; Docker fixes DATA_PATH at /app/data.
# Relative wheel overrides remain under that writable per-user directory.
# REST and MCP may run concurrently only with different DATA_PATH values.
# Keep each instance's DB_PATH, RAW_PATH, and VERSION_FILE aligned with that
# instance; two instances must not share any of those paths.
# DATA_PATH/sync.lock is a persistent OS-lock rendezvous file. Its presence or
# age does not prove that the lock is active. Never delete or replace it to
# force startup or resync; stop the current owner or use another data path.
# Before upgrading from a pre-lifetime-lock release, stop all old REST/MCP,
# resync, and maintenance processes that use this storage.
# DATA_PATH=./data
# DB_PATH=./data/aidefend_kb.lancedb
# RAW_PATH=./data/raw_content
# VERSION_FILE=./data/local_version.json
# LOG_PATH=./data/logs/aidefend_mcp.log

# Advanced: Embedding model (uses FastEmbed with ONNX Runtime)
# Default: Xenova/multilingual-e5-base (Microsoft, multilingual, 768-dim, 512 tokens, 100+ languages)
# - Model size: ~280 MB (int8 quantized), supports cross-language semantic search
# - Allows users to query in any language (e.g., Chinese, Japanese) and match English content
# Alternative options:
# - intfloat/multilingual-e5-small: Smaller (113 MB), 384-dim, good performance
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2: 220 MB, 384-dim, 50+ languages
# Embedding Configuration
EMBEDDING_MODEL=Xenova/multilingual-e5-base
EMBEDDING_DIMENSION=768
