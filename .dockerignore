# Docker ignore file - exclude unnecessary files from build context

# Data and databases
data/
models/
*.lancedb/
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Environment
.env*
.mcp.json

# Machine-local credentials and private material. These files are never
# runtime inputs and must not be sent to local or remote Docker builders.
*.key
*.pem
*.p12
*.pfx
*.p8
*.ppk
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.npmrc
.pypirc
.netrc
_netrc
*_secret*
*_private*
*credentials*.json
*credentials*.yaml
*credentials*.yml
*secrets*.json
*secrets*.yaml
*secrets*.yml

# Documentation (not needed in container)
README.md
SECURITY.md
docs/

# Testing
tests/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
test-artifacts/
.release-check-*/
.wheelcheck/
.pytest-*/
.tmp_pytest*/
.tmp_*/
*.tmp
temp/
tmp/

# Local dependency and agent/tool state. None of these are runtime inputs, and
# sending them to a remote builder can leak local artifacts or add hundreds of
# megabytes to the build context.
node_modules/
devtools/
.claude/
.agents/
.codex/
CLAUDE*.md
UPGRADE*.md
UPDATE*.md
*UPDATE*REPORT*.md
*.whl

# Development dependencies
requirements-dev.txt

# Docker
Dockerfile
docker-compose.yml
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Windows command error artifacts
nul
