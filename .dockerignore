# Docker ignore file - exclude unnecessary files from build context

# Data and databases
data/
*.lancedb/
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Environment
.env*

# Documentation (not needed in container)
README.md
SECURITY.md
docs/

# Testing
tests/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.hypothesis/
test-artifacts/
.release-check-*/
.wheelcheck/
.tmp_*/

# Local dependency and agent/tool state. None of these are runtime inputs, and
# sending them to a remote builder can leak local artifacts or add hundreds of
# megabytes to the build context.
node_modules/
.claude/
.agents/
.codex/
*.whl

# Development dependencies
requirements-dev.txt

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
